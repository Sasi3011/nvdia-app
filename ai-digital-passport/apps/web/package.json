    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capgo/capacitor-updater": "^6.51.16",
    "@tanstack/react-query": "^5.56.2",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.46.0",
    "next": "14.2.13",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
