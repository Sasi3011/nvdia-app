{
  "name": "@ai-digital-passport/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --port 1001",
    "build": "next build",
    "start": "next start --port 1001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
