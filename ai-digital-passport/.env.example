# Copy this file to .env at the repo root (and to infra/.env for Docker
# Compose, or run compose with --env-file ../.env) and fill in real values.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Database (PostgreSQL, accessed via Prisma — packages/database)
# ---------------------------------------------------------------------------
# Full connection string Prisma uses. Must match the Postgres credentials
# below when using the local docker-compose service. Host port defaults to
# 5434 (not the standard 5432) to avoid colliding with any Postgres already
# installed/running natively on your machine — change POSTGRES_PORT below
# if 5434 is also taken.
DATABASE_URL="postgresql://adp:adp@localhost:5434/ai_digital_passport?schema=public"
# Individual credentials consumed by infra/docker-compose.yml to init the
# local Postgres container.
POSTGRES_USER="adp"
POSTGRES_PASSWORD="adp"
POSTGRES_DB="ai_digital_passport"
POSTGRES_PORT="5434"

# ---------------------------------------------------------------------------
# Cache (Redis, accessed via ioredis — apps/api)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth (Google OAuth 2.0 via Passport.js — apps/api only, NestJS backend)
# ---------------------------------------------------------------------------
# OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Where Google redirects after consent — must match a redirect URI
# registered in Google Cloud Console.
GOOGLE_CALLBACK_URL="http://localhost:1002/auth/google/callback"
# Secret used to sign the httpOnly session cookie apps/api issues after
# login (never stored in localStorage). Generate with:
#   openssl rand -base64 32
# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Anyone who knows this value can sign in as any user, so never reuse or commit it.
SESSION_SECRET=""
# Sign-in is restricted to this institutional email domain (BR-01).
ALLOWED_EMAIL_DOMAIN="sece.ac.in"
# Optional: set only in production if apps/web and apps/api are deployed
# as subdomains of the same parent domain (e.g. ".aidigitalpassport.app")
# so the session cookie is sent on requests between them without needing
# SameSite=None. Leave blank for local dev (localhost works across ports
# without this) and for any deployment where web/api are on unrelated
# domains — see the README's deployment notes on why same-parent-domain
# is the recommended production topology.
COOKIE_DOMAIN=""

# ---------------------------------------------------------------------------
# File storage (private AWS S3 bucket, via @aws-sdk/client-s3 — apps/api)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"

# ---------------------------------------------------------------------------
# Backend server (apps/api, NestJS)
# ---------------------------------------------------------------------------
# Port the NestJS API listens on.
PORT="1002"
# Comma-separated list of origins allowed to call the API with credentials
# (cookies) — must include every origin apps/web is served from.
WEB_ORIGIN="http://localhost:1001"

# ---------------------------------------------------------------------------
# OTA updates (Phase 8, @capgo/capacitor-updater, self-hosted — apps/api,
# scripts/ota-publish.mjs)
# ---------------------------------------------------------------------------
# Bearer secret for POST /admin/ota/* — this is how scripts/ota-publish.mjs
# authenticates (a release script, not a logged-in browser session).
# Generate with: openssl rand -base64 32
OTA_PUBLISH_API_KEY=""

# ---------------------------------------------------------------------------
# Frontend <-> backend wiring (apps/web)
# ---------------------------------------------------------------------------
# Base URL apps/web uses to call apps/api. Prefix with NEXT_PUBLIC_ only the
# variant that must be readable from the browser bundle (the statically
# exported app has no server to hide it behind).
API_BASE_URL="http://localhost:1002"
NEXT_PUBLIC_API_BASE_URL="http://localhost:1002"
# Display-only echo of ALLOWED_EMAIL_DOMAIN above, shown on the Login page
# ("Only @sece.ac.in accounts can sign in") — not a security boundary,
# BR-01 is enforced server-side regardless of this value.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="sece.ac.in"

# Local-development password sign-in used by the login page. Off unless
# DEV_LOGIN_ENABLED is "true" and a password is set; always off in production.
DEV_LOGIN_ENABLED="false"
DEV_LOGIN_PASSWORD=""
