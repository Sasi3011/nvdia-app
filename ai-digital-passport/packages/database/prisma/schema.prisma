  badge_id    String
  trigger     String
  threshold   Int
  active      Boolean  @default(true)
  created_at  DateTime @default(now())

  badge Badge @relation(fields: [badge_id], references: [badge_id])

  @@index([trigger])
  @@map("badge_rules")
}

model ProblemProject {
  project_id   String   @id @default(uuid())
  problem_id   String
  user_id      String
  current_stage Int     @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  problem    IndustryProblem @relation(fields: [problem_id], references: [problem_id])
  user       User            @relation(fields: [user_id], references: [user_id])
  milestones ProblemMilestone[]

  @@index([problem_id])
  @@index([user_id])
  @@map("problem_projects")
}

model ProblemMilestone {
  milestone_id String      @id @default(uuid())
  project_id   String
  target_stage Int
  evidence_url String?
  details      Json?
  status       ClaimStatus @default(PENDING)
  feedback     String?
  reviewed_by  String?
  reviewed_at  DateTime?
  created_at   DateTime    @default(now())

  project  ProblemProject @relation(fields: [project_id], references: [project_id])
  reviewer User?          @relation(fields: [reviewed_by], references: [user_id])

  @@index([project_id])
  @@map("problem_milestones")
}

// Open decision #5 — same approve/reject-with-feedback pattern as claim
// review, reusing ClaimStatus.
model StartupMilestone {
  milestone_id String      @id @default(uuid())
  project_id   String
  target_stage Int
  evidence_url String?
  // Stage-specific form fields + uploaded document keys (JSON).
  details      Json?
  status       ClaimStatus @default(PENDING)
  feedback     String?
  reviewed_by  String?
  reviewed_at  DateTime?
  created_at   DateTime    @default(now())

  project  StartupProject @relation(fields: [project_id], references: [project_id])
  reviewer User?          @relation(fields: [reviewed_by], references: [user_id])

  @@index([project_id])
  @@map("startup_milestones")
}

model Badge {
  badge_id    String   @id @default(uuid())
  name        String   @unique
  description String?
  icon_key    String?
  created_at  DateTime @default(now())

  user_badges UserBadge[]
  rules       BadgeRule[]

  @@map("badges")
}

model UserBadge {
  user_badge_id String   @id @default(uuid())
  user_id       String
  badge_id      String
  awarded_at    DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [user_id])
  badge Badge @relation(fields: [badge_id], references: [badge_id])

  @@unique([user_id, badge_id])
  @@map("user_badges")
}

model Award {
  award_id    String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())

  nominations AwardNomination[]

  @@map("awards")
}

model AwardNomination {
  nomination_id String           @id @default(uuid())
  award_id      String
  nominee_id    String
  audit_run_id  String?
  status        NominationStatus @default(NOMINATED)
  requested_by  String?
  reason        String?
  admin_note    String?
  created_at    DateTime         @default(now())

  award     Award           @relation(fields: [award_id], references: [award_id])
  nominee   User            @relation(fields: [nominee_id], references: [user_id])
  audit_run AnnualAuditRun? @relation(fields: [audit_run_id], references: [audit_run_id])

  @@index([requested_by])
  @@map("award_nominations")
}

model FellowshipCandidate {
  candidate_id String   @id @default(uuid())
  user_id      String
  audit_run_id String?
  rank         Int?
  total_points Int
  notes        String?
  created_at   DateTime @default(now())

  user      User            @relation(fields: [user_id], references: [user_id])
  audit_run AnnualAuditRun? @relation(fields: [audit_run_id], references: [audit_run_id])

  @@index([audit_run_id])
  @@map("fellowship_candidates")
}

// Open decision #6 — admin-triggered, labelled with a free-text academic
// year, rather than cron-scheduled on a guessed date.
model AnnualAuditRun {
  audit_run_id    String   @id @default(uuid())
  triggered_by    String?
  academic_year   String
  candidate_count Int
  run_at          DateTime @default(now())

  triggerer   User?                 @relation(fields: [triggered_by], references: [user_id])
  candidates  FellowshipCandidate[]
  nominations AwardNomination[]

  @@map("annual_audit_runs")
}

model AuditLog {
  audit_log_id String   @id @default(uuid())
  actor_id     String?
  action       String
  entity_type  String
  entity_id    String?
  metadata     Json?
  created_at   DateTime @default(now())

  actor User? @relation(fields: [actor_id], references: [user_id])

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

// Configurable points-per-activity-category matrix (Section 11.1) — stored
// as data so FR-GAME-01/Section 24 Maintainability ("keep points rules
// configurable rather than hard-coded") holds. `category` is the natural
// key both the seed data and `activity_claims.category` use.
model ScoringRule {
  category            String   @id
  label               String
  points              Int
  // Open decision #4 — nullable = unlimited until a cap is configured.
  max_claims_per_user Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  claims ActivityClaim[]
  events Event[]

  @@map("scoring_rules")
}

// Phase 8 — OTA updates (Capacitor, @capgo/capacitor-updater, self-hosted).
// One row per published JS/HTML/CSS bundle. The native app polls
// GET-latest against this table's data (apps/api's OtaController) using
// the plugin's own wire format — see apps/api/src/ota/ota.service.ts for
// the exact request/response contract, reverse-verified from the
// plugin's Android source rather than guessed.
enum OtaPlatform {
  ANDROID
  IOS
}

model OtaBundle {
  bundle_id  String      @id @default(uuid())
  app_id     String
  platform   OtaPlatform
  channel    String      @default("production")
  version    String
  s3_key     String
  size_bytes Int
  checksum   String?
  active     Boolean     @default(true)
  notes      String?
  created_by String?
  created_at DateTime    @default(now())

  creator User? @relation(fields: [created_by], references: [user_id])

  @@unique([app_id, platform, channel, version])
  @@index([app_id, platform, channel, active])
  @@map("ota_bundles")
}

// ---------------------------------------------------------------------------
// Assigned Courses feature (additive — Admin/Mentor-assigned courses with
// an optional Proctored Live Session task type). Reuses PointsTransaction,
// Notification, AuditLog rather than parallel tables for those concerns.
// BR numbering continues the spec's scheme:
//   BR-13: courses are created/edited only by Admin or Mentor.
//   BR-14: an enrollment can only move to APPROVED once proof is submitted
//          AND every required task is COMPLETED (not LOCKED) for that
//          student (apps/api/src/courses/courses.service.ts).
//   BR-15: proctoring violations 1-3 notify the department mentor (or all
//          mentors if the department has none assigned) and allow the
//          session to continue; violation 4 locks it.
//   BR-16: a LOCKED proctoring session can only be reopened by a mentor's
//          explicit "grant access" action — never by the student.
//   BR-17: every lock and every mentor-granted unlock is audit-logged
//          (SEC-09 pattern), in addition to the timestamps/actor columns
//          kept directly on the row for fast display.
// ---------------------------------------------------------------------------

model Course {
  course_id         String       @id @default(uuid())
  title             String
  description       String
  short_description String       @default("")
  category          String       @default("AI Foundation")
  difficulty        String       @default("Beginner")
  duration_hours    Int          @default(0)
  duration_weeks    Int?
  delivery_mode     String       @default("Online")
  enrollment_type   String       @default("Open")
  certificate_available Boolean  @default(true)
  is_featured       Boolean      @default(false)
  skills_covered    String[]     @default([])
  prerequisites     String[]     @default([])
  learning_outcomes String[]     @default([])
  tools_required    String[]     @default([])
  target_audience   String       @default("")
  // Free text by design (spec request: "Coursera", "Udemy", "NPTEL", ...)
  // — not an enum, since the set of providers isn't fixed or spec-defined.
  provider          String
  external_url      String
  points_value      Int
  // Nullable = no minimum level (open-decision style: don't invent a
  // default floor the product owner didn't ask for).
  level_requirement Int?
  status            CourseStatus @default(DRAFT)
  created_by        String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  creator     User?              @relation(fields: [created_by], references: [user_id])
  tasks       CourseTask[]
  enrollments CourseEnrollment[]

  @@index([status])
  @@map("courses")
}

model CourseEnrollment {
  enrollment_id       String           @id @default(uuid())
  course_id           String
  user_id             String
  status              EnrollmentStatus @default(NOT_STARTED)
  submitted_proof_url String?
  submitted_at        DateTime?
  reviewed_by         String?
  review_feedback     String?
  reviewed_at         DateTime?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  course      Course             @relation(fields: [course_id], references: [course_id])
  student     User               @relation("CourseEnrollee", fields: [user_id], references: [user_id])
  reviewer    User?              @relation("CourseReviewer", fields: [reviewed_by], references: [user_id])
  transaction PointsTransaction?

  // One enrollment per student per course — resubmission after rejection
  // reuses the same row rather than creating a second one.
  @@unique([course_id, user_id])
  @@index([status])
  @@map("course_enrollments")
}

model CourseTask {
  task_id        String         @id @default(uuid())
  course_id      String
  title          String
  type           CourseTaskType @default(STANDARD)
  instructions   String?
  content        Json?
  sequence_order Int            @default(0)
  is_required    Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  course              Course                 @relation(fields: [course_id], references: [course_id])
  completions         CourseTaskCompletion[]
  proctoring_sessions ProctoringSession[]

  @@index([course_id])
  @@map("course_tasks")
}

// STANDARD tasks have no proctoring — this is the whole "student marks
// complete" record for them. LIVE_PROCTORED tasks are instead considered
// complete once their latest ProctoringSession.status is COMPLETED; see
// CoursesService.isTaskComplete.
model CourseTaskCompletion {
  completion_id String   @id @default(uuid())
  task_id       String
  user_id       String
  completed_at  DateTime @default(now())
  score         Int?
  feedback      String?

  task CourseTask @relation(fields: [task_id], references: [task_id])
  user User       @relation(fields: [user_id], references: [user_id])

  @@unique([task_id, user_id])
  @@map("course_task_completions")
}

model ProctoringSession {
  session_id      String           @id @default(uuid())
  task_id         String
  user_id         String
  status          ProctoringStatus @default(ACTIVE)
  violation_count Int              @default(0)
  started_at      DateTime         @default(now())
  ended_at        DateTime?
  locked_at       DateTime?
  unlocked_by     String?
  unlocked_at     DateTime?

  task       CourseTask            @relation(fields: [task_id], references: [task_id])
  user       User                  @relation("ProctoringSessionUser", fields: [user_id], references: [user_id])
  unlocker   User?                 @relation("ProctoringSessionUnlocker", fields: [unlocked_by], references: [user_id])
  violations ProctoringViolation[]

  @@index([task_id, user_id])
  @@index([status])
  @@map("proctoring_sessions")
}

model ProctoringViolation {
  violation_id    String        @id @default(uuid())
  session_id      String
  violation_type  ViolationType
  occurred_at     DateTime      @default(now())
  mentor_notified Boolean       @default(false)

  session ProctoringSession @relation(fields: [session_id], references: [session_id])

  @@index([session_id])
  @@map("proctoring_violations")
}

model StoredFile {
  file_id       String   @id @default(uuid())
  original_name String
  mime_type     String
  size_bytes    Int
  file_data     Bytes
  entity_type   String?
  entity_id     String?
  uploaded_by   String?
  created_at    DateTime @default(now())

  uploader User? @relation(fields: [uploaded_by], references: [user_id])

  @@index([entity_type, entity_id])
  @@index([uploaded_by])
  @@map("stored_files")
}

// Hackathons discovered on external platforms (Devpost / Unstop / Devfolio)
// or added manually by admins and mentors. Separate from the in-house
// Hackathon model, which tracks teams and submissions inside the portal.
model ExternalHackathon {
  external_id  String    @id @default(uuid())
  source       String
  source_ref   String
  title        String
  description  String    @default("")
  url          String
  image_url    String?
  organizer    String?
  location     String?
  is_online    Boolean   @default(false)
  prize        String?
  tags         String[]
  starts_at    DateTime?
  ends_at      DateTime?
  deadline_at  DateTime?
  added_by     String?
  register_points Int    @default(20)
  locked       Boolean   @default(false)
  hidden       Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  registrations ExternalHackathonRegistration[]

  @@unique([source, source_ref])
  @@index([ends_at])
  @@map("external_hackathons")
}

model ExternalHackathonRegistration {
  registration_id String   @id @default(uuid())
  external_id     String
  user_id         String
  points_awarded  Int
  claim_id        String?  @unique
  created_at      DateTime @default(now())

  hackathon ExternalHackathon @relation(fields: [external_id], references: [external_id], onDelete: Cascade)

  @@unique([external_id, user_id])
  @@index([user_id])
  @@map("external_hackathon_registrations")
}

// Emails allowed to sign in (managed on the admin User Management page).
model AccessWhitelist {
  email         String    @id
  full_name     String?
  role          String    @default("STUDENT")
  department    String    @default("")
  year          String?
  status        String    @default("AUTHORIZED")
  source        String    @default("Manual Admin Entry")
  added_by      String?
  added_at      DateTime  @default(now())
  last_login_at DateTime?
  updated_at    DateTime  @default(now()) @updatedAt

  @@index([role])
  @@index([status])
  @@map("access_whitelist")
}
