// AI Digital Passport — Prisma schema
//
// Data model per spec file 03 (Section 8): baseline tables use the exact
// field names given there (level_id, level_name, min_points,
// unlocked_privilege / user_id, email, full_name, register_num,
// department, cohort_year, current_level_id, total_points,
// gpu_credit_balance / claim_id, user_id, category, proof_type, proof_url,
// points_requested, status, mentor_feedback, reviewed_by / project_id,
// lead_student_id, title, current_stage, gpu_validated). Extension tables
// (Section 8.2) are designed to support every workflow in spec file 03 and
// every endpoint/business rule in spec file 04.
//
// Configurable-by-design per spec file 05 Section 16 "Open Decisions" —
// see inline notes:
//   - Level 6 "High Impact" (#1): `levels.requires_high_impact` + a
//     per-student `students.high_impact_flag` an admin sets manually (via the
//     points/level correction tool) until a numeric rule is defined.
//   - GPU credit rules (#2): `gpu_credit_balance` is admin-adjustable only
//     (via an audited correction), no auto-accrual/expiry logic invented.
//   - Mentor assignment (#3): no assignment table — `activity_claims` has
//     no `assigned_to`, so the mentor queue is a shared pool by default;
//     `reviewed_by` is only set once a mentor actually reviews it.
//   - Duplicate claims (#4): `scoring_rules.max_claims_per_user` is
//     nullable (= unlimited) so a cap can be configured later per
//     category without a schema change.
//   - Startup stage transitions (#5): `startup_milestones` uses the same
//     PENDING/APPROVED/REJECTED review pattern as activity claims.
//   - Annual audit timing (#6): `annual_audit_runs` is admin-triggered
//     (labelled with a free-text academic_year), not cron-scheduled on a
//     guessed date.
//   - Notification provider (#7): `notifications` is a plain internal
//     table; no external push integration.
//   - Problem Bank content model (#8): title, description, status
//     (draft/published/archived), level_requirement — the spec's stated
//     minimum.
//   - Leaderboard tie-break (#9): NOT modeled here — the API layer ranks
//     by total_points desc, tie-break created_at asc (earliest to reach
//     the score wins), documented as an assumption pending product-owner
//     confirmation, not hard-coded as "the" rule.
//   - Data retention (#10): out of scope — no automated purge logic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — must stay in sync with packages/shared-types/src/enums.ts
// ---------------------------------------------------------------------------

enum RoleName {
  STUDENT
  MENTOR
  ADMIN
  INDUSTRY_PARTNER
  EVALUATOR
}

// Section 11.4
enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// Section 11.5
enum ProofType {
  TOTP_QR
  PDF_FILE
  GITHUB_LINK
  DOI_LINK
}

// Open decision #8 — spec's stated minimum schema.
enum ProblemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  CLAIM_APPROVED
  CLAIM_REJECTED
  MENTOR_REVIEW_REMINDER
  LEVEL_UP
  AWARD_RESULT
  SYSTEM
}

enum NominationStatus {
  NOMINATED
  CONFIRMED
  DECLINED
}

// Assigned Courses feature (additive to spec files 01-05, added post-launch
// at product-owner request). Continues the existing enum-mirroring
// convention with packages/shared-types/src/enums.ts.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum CourseTaskType {
  STANDARD
  LIVE_PROCTORED
  MCQ
  CODING
}

enum ProctoringStatus {
  ACTIVE
  COMPLETED
  LOCKED
}

enum ViolationType {
  FULLSCREEN_EXIT
  TAB_SWITCH
  WINDOW_BLUR
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  MENTOR_RECOMMENDED
  APPROVED
  REJECTED
  ALLOCATED
  COMPLETED
}

enum HackathonStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  SUBMISSION_OPEN
  EVALUATION
  COMPLETED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Baseline tables (spec 03, Section 8.1) — exact field names
// ---------------------------------------------------------------------------

model Level {
  level_id             Int      @id
  level_name           String   @unique
  min_points           Int
  unlocked_privilege   String
  // Open decision #1 — only true for the one level whose threshold isn't
  // points-sufficient alone (Level 6 in the seeded data).
  requires_high_impact Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  students Student[]

  @@map("levels")
}

// Shared login identity for every account, whatever its role. Role-specific
// data lives in the per-role profile tables below (students, faculty,
// admins; plus industry_partners and evaluator_profiles), each 1:1 with a
// user. Every other table keeps pointing at users.user_id.
model User {
  user_id    String   @id @default(uuid())
  email      String   @unique
  full_name  String
  // Additive beyond the spec's minimal listing (Section 8.2 invites this):
  // stable Google identity + avatar, needed once Phase 3 wires real OAuth.
  google_id  String?  @unique
  avatar_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student Student?
  faculty Faculty?
  admin   Admin?

  user_roles              UserRole[]
  claims_made             ActivityClaim[]        @relation("ActivityClaimant")
  claims_reviewed         ActivityClaim[]        @relation("ActivityReviewer")
  claim_reviews           ClaimReview[]
  startup_projects        StartupProject[]
  milestones_reviewed     StartupMilestone[]
  points_transactions     PointsTransaction[]
  attendances             Attendance[]
  notifications           Notification[]
  problem_projects        ProblemProject[]
  problem_milestone_reviews ProblemMilestone[]
  problems_created        IndustryProblem[]
  user_badges             UserBadge[]
  award_nominations       AwardNomination[]
  fellowship_candidacies  FellowshipCandidate[]
  audit_logs              AuditLog[]
  events_created          Event[]
  class_teaching_logs     ClassTeachingLog[]
  audit_runs_triggered    AnnualAuditRun[]
  ota_bundles_published   OtaBundle[]
  courses_created         Course[]
  course_enrollments      CourseEnrollment[]     @relation("CourseEnrollee")
  course_reviews          CourseEnrollment[]     @relation("CourseReviewer")
  course_task_completions CourseTaskCompletion[]
  proctoring_sessions     ProctoringSession[]    @relation("ProctoringSessionUser")
  proctoring_unlocks      ProctoringSession[]    @relation("ProctoringSessionUnlocker")
  stored_files            StoredFile[]
  gpu_requests            GpuRequest[]           @relation("GpuRequestStudent")
  gpu_requests_reviewed   GpuRequest[]           @relation("GpuRequestReviewer")
  hackathon_teams_led     HackathonTeam[]
  hackathon_team_members  HackathonTeamMember[]
  hackathon_evaluations   HackathonEvaluation[]  @relation("HackathonEvaluationEvaluator")
  industry_partner        IndustryPartner?
  evaluator_profile       EvaluatorProfile?
  project_records_led     ProjectRecord[]
  project_milestones_reviewed ProjectMilestone[]
  certificates            GeneratedCertificate[]

  @@map("users")
}

// Profile for users holding the STUDENT role — points, level and credits
// only exist for students.
model Student {
  student_id         String   @id @default(uuid())
  user_id            String   @unique
  register_num       String   @unique
  department         String
  cohort_year        Int
  current_level_id   Int      @default(1)
  total_points       Int      @default(0)
  gpu_credit_balance Int      @default(0)
  // Open decision #1 — admin-settable pending a numeric Level 6 rule.
  high_impact_flag   Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user          User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  current_level Level @relation(fields: [current_level_id], references: [level_id])

  @@index([current_level_id])
  @@index([department])
  @@map("students")
}

// Profile for users holding the MENTOR role (faculty).
model Faculty {
  faculty_id        String   @id @default(uuid())
  user_id           String   @unique
  employee_id       String?  @unique
  department        String
  designation       String?
  // Assigned Courses feature: one mentor is assigned responsibility for a
  // given department's course-submission and proctoring-violation
  // notifications (product-owner request — "one dept, one mentor"), set by
  // an Admin. Nullable because not every mentor need own a department, and
  // there's deliberately no constraint capping one mentor per department —
  // a routing hint rather than a hard invariant (open decision #3).
  mentor_department String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([mentor_department])
  @@map("faculty")
}

// Profile for users holding the ADMIN role.
model Admin {
  admin_id    String   @id @default(uuid())
  user_id     String   @unique
  employee_id String?  @unique
  designation String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("admins")
}

model ActivityClaim {
  claim_id         String      @id @default(uuid())
  user_id          String
  category         String
  proof_type       ProofType
  proof_url        String?
  points_requested Int
  points_awarded   Int?
  status           ClaimStatus @default(PENDING)
  mentor_feedback  String?
  reviewed_by      String?
  reviewed_at      DateTime?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  claimant     User               @relation("ActivityClaimant", fields: [user_id], references: [user_id])
  reviewer     User?              @relation("ActivityReviewer", fields: [reviewed_by], references: [user_id])
  scoring_rule ScoringRule        @relation(fields: [category], references: [category])
  attachments  ClaimAttachment[]
  reviews      ClaimReview[]
  transaction  PointsTransaction?

  @@index([user_id])
  @@index([status])
  @@index([category])
  @@map("activity_claims")
}

model StartupProject {
  project_id      String   @id @default(uuid())
  lead_student_id String
  title           String
  // 1-6, validated at the application layer (Section 11.3 stage names).
  current_stage   Int      @default(1)
  gpu_validated   Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  lead       User               @relation(fields: [lead_student_id], references: [user_id])
  milestones StartupMilestone[]

  @@index([lead_student_id])
  @@map("startup_projects")
}

// ---------------------------------------------------------------------------
// Extension tables (spec 03, Section 8.2)
// ---------------------------------------------------------------------------

model Role {
  role_id String   @id @default(uuid())
  name    RoleName @unique

  user_roles UserRole[]

  @@map("roles")
}

model UserRole {
  user_role_id String   @id @default(uuid())
  user_id      String
  role_id      String
  granted_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])
  role Role @relation(fields: [role_id], references: [role_id])

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Event {
  event_id    String   @id @default(uuid())
  title       String
  description String?
  location    String?
  // Which scoring-matrix category a QR check-in for this event's sessions
  // awards (e.g. a GPU Friday Lab event maps to "gpu_friday_lab", +30) —
  // so the live-QR point value is configured data, not a hard-coded
  // assumption that every live event is worth the same amount.
  category    String
  year         String?
  department   String?
  session_type String?
  starts_at   DateTime
  ends_at     DateTime
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  creator      User?              @relation(fields: [created_by], references: [user_id])
  scoring_rule ScoringRule        @relation(fields: [category], references: [category])
  sessions     EventSession[]
  teaching_logs ClassTeachingLog[]

  @@index([category])
  @@map("events")
}

model EventSession {
  session_id        String   @id @default(uuid())
  event_id          String
  title             String
  starts_at         DateTime
  ends_at           DateTime
  // TOTP-backed live QR (FR-VERIF-01): secret only present once a session
  // is activated; window defaults to the spec's 15-second refresh.
  qr_secret         String?
  qr_active         Boolean  @default(false)
  qr_window_seconds Int      @default(30)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  event       Event        @relation(fields: [event_id], references: [event_id])
  qr_tokens   QrToken[]
  attendances Attendance[]

  @@index([event_id])
  @@map("event_sessions")
}

// One row logged per generated QR code window, for audit (SEC-09) —
// validation itself is stateless TOTP against `event_sessions.qr_secret`,
// this table is metadata, not the source of truth for validity.
model QrToken {
  qr_token_id  String   @id @default(uuid())
  session_id   String
  token        String
  window_start DateTime
  window_end   DateTime
  generated_at DateTime @default(now())

  session     EventSession @relation(fields: [session_id], references: [session_id])
  attendances Attendance[]

  @@index([session_id, token])
  @@map("qr_tokens")
}

model Attendance {
  attendance_id String   @id @default(uuid())
  user_id       String
  session_id    String
  qr_token_id   String?
  checked_in_at DateTime @default(now())

  user     User         @relation(fields: [user_id], references: [user_id])
  session  EventSession @relation(fields: [session_id], references: [session_id])
  qr_token QrToken?     @relation(fields: [qr_token_id], references: [qr_token_id])

  // BR-05 / SEC-08: no duplicate attendance for the same event by the same
  // student.
  @@unique([user_id, session_id])
  @@map("attendance")
}

// Faculty-authored record of what was actually taught in a CoE Class
// session — separate from Attendance (which just proves a student showed
// up). Mentors log/update their own entries; admin reads every entry
// across all departments/mentors (no department scoping, same convention
// as the rest of the app — department is metadata, not an access filter).
model ClassTeachingLog {
  log_id         String   @id @default(uuid())
  event_id       String
  mentor_id      String
  class_date     DateTime
  topics_covered String
  materials_url  String?
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  event  Event @relation(fields: [event_id], references: [event_id])
  mentor User  @relation(fields: [mentor_id], references: [user_id])

  @@index([event_id])
  @@index([mentor_id])
  @@map("class_teaching_logs")
}

// Append-only points ledger (BR-12 traceability). `claim_id` is unique so
// at most one transaction can ever exist per claim — this is what makes
// point allocation idempotent (BR-04/BR-06, NFR reliability) regardless of
// whether the claim came from a QR scan or a mentor approval.
model PointsTransaction {
  transaction_id String   @id @default(uuid())
  user_id        String
  claim_id       String?  @unique
  // Assigned Courses feature: a second, independent idempotency key —
  // mirrors claim_id's unique-constraint trick (BR-04/BR-06) so course
  // approvals reuse the exact same "unique violation = already applied,
  // no-op" pattern as PointsService.awardForClaim, rather than a new
  // approval pipeline.
  enrollment_id  String?  @unique
  points         Int
  reason         String
  created_at     DateTime @default(now())

  user       User              @relation(fields: [user_id], references: [user_id])
  claim      ActivityClaim?    @relation(fields: [claim_id], references: [claim_id])
  enrollment CourseEnrollment? @relation(fields: [enrollment_id], references: [enrollment_id])

  @@index([user_id])
  @@map("points_transactions")
}

// Mentor review history — separate from the claim's current state so a
// re-review doesn't lose prior history (spec 03 Section 8.2).
model ClaimReview {
  review_id   String      @id @default(uuid())
  claim_id    String
  reviewer_id String
  decision    ClaimStatus
  comment     String?
  created_at  DateTime    @default(now())

  claim    ActivityClaim @relation(fields: [claim_id], references: [claim_id])
  reviewer User          @relation(fields: [reviewer_id], references: [user_id])

  @@index([claim_id])
  @@map("claim_reviews")
}

model ClaimAttachment {
  attachment_id String   @id @default(uuid())
  claim_id      String
  file_key      String
  file_name     String
  mime_type     String
  size_bytes    Int
  created_at    DateTime @default(now())

  claim ActivityClaim @relation(fields: [claim_id], references: [claim_id])

  @@index([claim_id])
  @@map("claim_attachments")
}

model Notification {
  notification_id String           @id @default(uuid())
  user_id         String
  type            NotificationType
  title           String
  message         String
  read_at         DateTime?
  created_at      DateTime         @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id, read_at])
  @@map("notifications")
}

// Open decision #8 — minimum schema per spec: title, description, status,
// level_requirement.
model IndustryProblem {
  problem_id        String        @id @default(uuid())
  title             String
  description       String
  organization      String?
  status            ProblemStatus @default(DRAFT)
  level_requirement Int           @default(3)
  // Original file (PDF / Excel / Word ...) kept instead of parsed text; points at stored_files.file_id.
  attachment_file_key   String?
  attachment_file_name  String?
  attachment_mime_type  String?
  attachment_size_bytes Int?
  created_by        String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  creator     User?               @relation(fields: [created_by], references: [user_id])
  projects    ProblemProject[]
  project_records ProjectRecord[]

  @@index([status])
  @@map("industry_problems")
}

model GpuRequest {
  gpu_request_id      String        @id @default(uuid())
  student_id          String
  purpose             String
  title               String
  justification       String
  requested_credits   Int
  allocated_credits   Int?
  status              RequestStatus @default(DRAFT)
  mentor_comment      String?
  admin_comment       String?
  reviewed_by         String?
  reviewed_at         DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  student  User  @relation("GpuRequestStudent", fields: [student_id], references: [user_id])
  reviewer User? @relation("GpuRequestReviewer", fields: [reviewed_by], references: [user_id])

  @@index([student_id])
  @@index([status])
  @@map("gpu_requests")
}

model IndustryPartner {
  partner_id     String   @id @default(uuid())
  user_id        String   @unique
  company_name   String
  contact_person String
  website        String?
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])

  @@map("industry_partners")
}

// GPU access requests raised by industry companies; entered/managed by admins.
model IndustryGpuRequest {
  request_id     String   @id @default(uuid())
  company_name   String
  contact_person String
  contact_email  String?
  contact_phone  String?
  website        String?
  sector         String?
  use_case       String
  gpu_type       String?
  gpu_count      Int?
  hours_needed   Int?
  duration       String?
  status         String   @default("NEW")
  admin_notes    String?
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([status])
  @@map("industry_gpu_requests")
}

model EvaluatorProfile {
  evaluator_id String   @id @default(uuid())
  user_id      String   @unique
  expertise    String[] @default([])
  status       String   @default("ACTIVE")
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@map("evaluator_profiles")
}

model Hackathon {
  hackathon_id        String          @id @default(uuid())
  title               String
  description         String
  theme               String?
  starts_at           DateTime
  ends_at             DateTime
  registration_deadline DateTime?
  team_size_min       Int             @default(1)
  team_size_max       Int             @default(4)
  status              HackathonStatus @default(DRAFT)
  points_participation Int            @default(100)
  points_winner       Int             @default(250)
  created_by          String?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  problems    HackathonProblem[]
  teams       HackathonTeam[]
  submissions HackathonSubmission[]

  @@index([status])
  @@map("hackathons")
}

model HackathonProblem {
  problem_id   String   @id @default(uuid())
  hackathon_id String
  title        String
  description  String
  created_at   DateTime @default(now())

  hackathon Hackathon @relation(fields: [hackathon_id], references: [hackathon_id])
  teams     HackathonTeam[]

  @@index([hackathon_id])
  @@map("hackathon_problems")
}

model HackathonTeam {
  team_id      String   @id @default(uuid())
  hackathon_id String
  problem_id   String?
  name         String
  lead_id      String
  created_at   DateTime @default(now())

  hackathon   Hackathon             @relation(fields: [hackathon_id], references: [hackathon_id])
  problem     HackathonProblem?     @relation(fields: [problem_id], references: [problem_id])
  lead        User                  @relation(fields: [lead_id], references: [user_id])
  members     HackathonTeamMember[]
  submissions HackathonSubmission[]

  @@index([hackathon_id])
  @@index([lead_id])
  @@map("hackathon_teams")
}

model HackathonTeamMember {
  member_id String   @id @default(uuid())
  team_id   String
  user_id   String
  role      String   @default("MEMBER")
  joined_at DateTime @default(now())

  team HackathonTeam @relation(fields: [team_id], references: [team_id])
  user User          @relation(fields: [user_id], references: [user_id])

  @@unique([team_id, user_id])
  @@map("hackathon_team_members")
}

model HackathonSubmission {
  submission_id String   @id @default(uuid())
  hackathon_id  String
  team_id       String
  title         String
  summary       String
  github_url    String?
  demo_url      String?
  file_key      String?
  submitted_at  DateTime @default(now())

  hackathon   Hackathon              @relation(fields: [hackathon_id], references: [hackathon_id])
  team        HackathonTeam          @relation(fields: [team_id], references: [team_id])
  evaluations HackathonEvaluation[]

  @@index([hackathon_id])
  @@index([team_id])
  @@map("hackathon_submissions")
}

model HackathonEvaluation {
  evaluation_id String   @id @default(uuid())
  submission_id String
  evaluator_id  String
  innovation    Int
  technical     Int
  impact        Int
  presentation  Int
  completeness  Int
  comments      String?
  total_score   Int
  created_at    DateTime @default(now())

  submission HackathonSubmission @relation(fields: [submission_id], references: [submission_id])
  evaluator  User                @relation("HackathonEvaluationEvaluator", fields: [evaluator_id], references: [user_id])

  @@unique([submission_id, evaluator_id])
  @@index([evaluator_id])
  @@map("hackathon_evaluations")
}

model ProjectRecord {
  project_id          String   @id @default(uuid())
  lead_student_id     String
  title               String
  problem_statement   String
  project_type        String
  status              String   @default("DRAFT")
  mentor_id           String?
  industry_problem_id String?
  github_url          String?
  demo_url            String?
  report_file_key     String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  lead             User             @relation(fields: [lead_student_id], references: [user_id])
  industry_problem IndustryProblem? @relation(fields: [industry_problem_id], references: [problem_id])
  milestones       ProjectMilestone[]

  @@index([lead_student_id])
  @@index([status])
  @@map("project_records")
}

model ProjectMilestone {
  milestone_id String        @id @default(uuid())
  project_id   String
  title        String
  description  String
  due_at       DateTime?
  evidence_url String?
  status       RequestStatus @default(DRAFT)
  feedback     String?
  reviewed_by  String?
  reviewed_at  DateTime?
  created_at   DateTime      @default(now())

  project  ProjectRecord @relation(fields: [project_id], references: [project_id])
  reviewer User?         @relation(fields: [reviewed_by], references: [user_id])

  @@index([project_id])
  @@index([status])
  @@map("project_milestones")
}

model GeneratedCertificate {
  certificate_id String   @id @default(uuid())
  user_id        String
  title          String
  certificate_type String
  file_key       String?
  issued_by      String?
  issued_at      DateTime @default(now())
  metadata       Json?

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("generated_certificates")
}

model BadgeRule {
